{
  "name": "sonascope",
  "version": "0.1.0",
  "description": "A TypeScript audio analysis library and browser workbench.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./io": {
      "types": "./dist/io/index.d.ts",
      "import": "./dist/io/index.js"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork --testTimeout=10000",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "demo:build": "npm run build && node scripts/build-demo.mjs",
    "demo:serve": "node scripts/serve-demo.mjs",
    "demo": "npm run demo:build && npm run demo:serve",
    "test:types": "tsc -p tsconfig.test.json",
    "test:all": "npm run test:types && npm test -- --reporter=dot",
    "test:examples": "node scripts/check-examples.mjs",
    "test:package": "node scripts/check-package.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "audio",
    "fft",
    "stft",
    "spectrum",
    "mel",
    "waveform",
    "analysis",
    "webaudio",
    "visualization"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.10.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  },
  "author": "Huang Zeyao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranshufang55/sonascope.git"
  }
}
